# Copy to .env and fill in. .env is gitignored -- no credentials in the repo.

# --- LLM provider (defaults target Groq) ---
GROQ_API_KEY=

# Any OpenAI-compatible endpoint works; these are the only provider-specific settings.
# FKL_LLM_BASE_URL=https://api.groq.com/openai/v1
# FKL_LLM_API_KEY_ENV=GROQ_API_KEY
# FKL_LLM_MODEL=openai/gpt-oss-120b
# FKL_JUDGE_MODEL=openai/gpt-oss-120b

# --- tuning ---
# FKL_CHUNK_CHARS=8000            # page text per extraction call
# FKL_EXTRACT_CONCURRENCY=6
# FKL_GROUNDING_THRESHOLD=0.80    # min fuzzy match for a quote to count as located
# FKL_REVIEW_THRESHOLD=0.60       # below this final confidence -> needs review
# FKL_MATCH_THRESHOLD=0.62        # cosine floor for two claims to be compared
